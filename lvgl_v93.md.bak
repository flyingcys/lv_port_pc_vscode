void lv_meter_set_indicator_end_value lv_obj_t *obj, lv_meter_indicator_t *indic, int32_t value);
```

该函数的形参，如下表所示：

<table><tr><td>参数</td><td>描述</td></tr><tr><td>obj</td><td>指向仪表对象的指针</td></tr><tr><td>indic</td><td>指向刻度对象</td></tr><tr><td>value</td><td>结束值</td></tr></table>

表 32.2.2.4 lv_meter_setindicator_end_value 函数形参描述

返回值：无。

接下来，我们以简单示例来理解仪表指示刻度的设置，示例代码如下所示：

```c
/* 获取当前活动屏幕的宽高 */
#define scr_act_width() lv_obj_get_width(lv_scr_act())
#define scr_actu height() lv_obj_get_heightlv_scract()
LV_IMAGE_DECLARE(img_hand)
```

```c
void lv_mainstart(void)   
{ lv_obj_t\* meter  $=$  lv_meter_create(lv_scr_act(); /\*定义并创建仪表\*/ lv_obj_set_width(meter,scr_act_height(); /\*设置仪表宽度\*/ lv_obj_set_height(meter,scr_act_height(); /\*设置仪表高度\*/ /\*设置仪表位置\*/ lv_obj_center(meter); /\*设置仪表刻度\*/ lv_meter_scale_t\* scale  $\equiv$  lv_meter_add_scale(meter); /\*定义并添加刻度\*/ /\*设置小刻度\*/ lv_meter_set_scale_tickss(meter, scale,41,1,10, lv_palette_main(LV_PALETTEGREY)); /\*设置主刻度\*/ lv_meter_set_scalemajor_ticks(meter, scale,8,1,10, lv_color_white(),scract_height() /30); /\*添加指针图像\*/ lv_meter_indicator_t\* indic  $\equiv$  lv_meter_add_needle_img(metric, scale, &img_hand,5,5); /\*设置指针指向的数值\*/ lv_meter_set_indicator_value(meter,indic,54); /\*添加指示刻度，起始颜色为浅蓝色，终止颜色为深蓝色，状态为true，指示刻度为10\*/ indic  $=$  lv_meter_add_scale Lines(meter, scale, lv_palette DARKEN(LV_PALETTE_BLUE,1), lv_palette DARKen(LV_PALETTE_BLUE,4), true,10); /\*设置指示刻度起始值为50\*/ lv_meter_set_indicator_start_value(meter,indic,50); /\*设置指示刻度终止值为100\*/ lv_meter_set_indicator_end_value(meter,indic,100); }
```

在上述源码中，我们在仪表中添加了指示刻度，该指示刻度由浅蓝色到深蓝色渐变，然后设置了指示刻度的起始值和终止值。示例代码可在PC模拟器上运行，效果如下所示：

![](images/c4cd27af769ade78367aa211c523f9921b36d35debba3f9b56b6ebe70ee74e31.jpg)  
图32.2.2.3设置指示刻度

# 3. 仪表弧线指示器

仪表弧线指示器也是一样比较常见的仪表功能，该功能和指示刻度具有相似的效果，主要用于引导和提示用户，其示意图如下所示：

![](images/2a807e709277f3f74196aad24ee58fa8932f6643af81a8d7e5d34ce19d3af1fc.jpg)  
图32.2.2.4添加仪表弧线指示器

上图中，我们在仪表中添加了弧线指示器，关于这个功能，LVGL官方提供了三个函数，如下表所示：

表 32.2.2.5 绘制弧线指示器相关函数  

<table><tr><td>函数</td><td>描述</td></tr><tr><td>lv_meter_addArc()</td><td>添加弧线指示器</td></tr><tr><td>lv_meter_setindicator_start_value()</td><td>设置指示刻度的起始值</td></tr><tr><td>lv_meter_setindicator_end_value()</td><td>设置指示刻度的终止值</td></tr></table>

上表中第二、三个函数我们已经讲解过，接下来重点介绍第一个函数：

lv_meter_add_ar函数

添加弧线指示器，该函数原型如下所示：

```txt
lv_meter_indicator_t *lv_meter_add.arc(lv_obj_t *obj,
```

```csv
lv_meter_scale_t *scale,  
uint16_t width,  
lv_color_t color,  
int16_t r_mod)
```

该函数的形参，如下表所示：

表 32.2.2.6 lv_meter_add.arc 函数形参描述  

<table><tr><td>参数</td><td>描述</td></tr><tr><td>obj</td><td>指向仪表对象的指针</td></tr><tr><td>scale</td><td>指向刻度对象</td></tr><tr><td>width</td><td>弧线宽度</td></tr><tr><td>color</td><td>弧线颜色</td></tr><tr><td>r_mod</td><td>偏移值</td></tr></table>

返回值：无。

接下来，我们以简单示例来理解仪表弧线指示器的添加，示例代码如下所示：

```c
/* 获取当前活动屏幕的宽高 */
#define scr_act_width() lv_obj_get_width(lv_scr_act())
#define scr_actu height() lv_obj_get_height(lv_scract())
LV_IMAGE.Declare(img_hand)
void lv_mainstart(void)
{
    lv_obj_t* meter = lv_meter_create(lv_scr_act()); /* 定义并创建仪表 */
    lv_obj_set_width(meter, scr_actu height()); /* 设置仪表宽度 */
    lv_obj_set_height(meter, scr_actu height()); /* 设置仪表高度 */
    /* 设置仪表位置 */
    lv_obj_center(meter);
    /* 设置仪表刻度 */
    lv_meter_scale_t* scale = lv_meter_add_scale(meter); /* 定义并添加刻度 */
    /* 设置小刻度 */
    lv_meter_set_scale_tickss(meter, scale, 41, 1, 10,
                          lv_palette_main(LV_PALETTEGREY));
    /* 设置主刻度 */
    lv_meter_set_scalemajor_ticks(meter, scale, 8, 1, 10,
                          lv_color_white(), scr_actu height() / 30);
    /* 添加指针图像 */
    lv_meter(indicator_t * indic = lv_meter_add_needle.img(meter,
                          scale,
                                  &img_hand, 5, 5);
    /* 设置指针指向的数值 */
    lv_meter_set_indicator_value(meter, indic, 54);
    /* 添加指示刻度，起始颜色为浅蓝色，终止颜色为深蓝色，状态为 true，指示刻度为 10 */
    indic = lv_meter_add_scale-lines(meter, scale,
                          lv_palette DARKEN(LV_PALETTE_BLUE, 1),
                          lv_palette DARKEN(LV_PALETTE_BLUE, 4),
                          true, 10);
```

```c
/\*设置指示刻度起始值为50\*/  
lv_meter_setindicator_start_value(metric，indic，50);  
/\*设置指示刻度终止值为100\*/  
lv_meter_setindicator_end_value(metric，indic，100);  
/\*添加弧线指示器，弧线宽度为10，颜色为红色，偏移10\*/  
indic  $=$  lv_meter_add_arc(metric，scale，10,lv_palette_main(LV_PALETTE_red)，10);  
lv_meter_setindicator_start_value(metric，indic，50);  
lv_meter_setindicator_end_value(metric，indic，100);
```

在上述源码中，我们调用了lv_meter_addArc函数来添加弧线指示器，该弧线指示器的宽度为10，弧线颜色为红色，弧线偏移10。示例代码可在PC模拟器上运行，效果如下所示：

![](images/d1f21205398de7dd4a105392eb35e0f9accd60dce5430e8218e85cf5e7fcdc30.jpg)  
图32.2.2.5添加弧线指示器

上图中，弧线指示器的范围是  $80\sim 100$  ，弧线往外偏移10步长。

# 32.3 仪表部件 API 函数

LVGL官方提供了一些与仪表部件相关API，如下表所示：  

<table><tr><td>函数</td><td>描述</td></tr><tr><td>lv_meter_create()</td><td>创建仪表对象</td></tr><tr><td>lv_meter_add_scale()</td><td>给仪表添加新刻度</td></tr><tr><td>lv_meter_set_scale_tickss()</td><td>设置小刻度的属性</td></tr><tr><td>lv_meter_set_scalemajor_ticks()</td><td>设置主刻度的属性</td></tr><tr><td>lv_meter_set_scale_range()</td><td>设置数值范围和角度范围</td></tr><tr><td>lv_meter_add_needle_line()</td><td>添加指针</td></tr></table>

表 32.3.1 仪表部件相关的 API 函数  

<table><tr><td>lv_meter_add_needle_img()</td><td>添加图片指针</td></tr><tr><td>lv_meter_addArc()</td><td>添加弧线指示器</td></tr><tr><td>lv_meter_add_scale-lines()</td><td>添加刻度线指示器</td></tr><tr><td>lv_meter_set_indicator_value()</td><td>设置指针的值</td></tr><tr><td>lv_meter_set_indicator_start_value()</td><td>设置刻度的起始值</td></tr><tr><td>lv_meter_set_indicator_end_value()</td><td>设置刻度的终止值</td></tr></table>

# 32.4 仪表部件实验

# 32.4.1 硬件设计

# 1. 例程功能

本实验主要测试仪表部件 API 函数的使用，实验现象：开机后，屏幕上显示三个不同样式和功能的仪表。与此同时，LED0 闪烁，提示系统正在运行。

该实验的完整源码，请参考《LVGL例程32lv_meter(仪表)》例程，路径：A盘  $\rightarrow 4$  ，程序源码  $\rightarrow 3$  ，扩展例程  $\rightarrow 4$  ，LVGL例程。

