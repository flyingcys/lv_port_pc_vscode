```

```c
/* */
* @brief LED事件回调
* @param *e：事件相关参数的集合，它包含了该事件的所有数据
* @return 无
*/ static void led_event_cb(lv_event_t* e)
{
    lv_obj_t* led = lv_event_get_target(e); /* 获取触发源 */
    lv_led Toggle(led); /* 翻转LED状态 */
}
/**
* @brief LED1
* @param 无
* @return 无
*/
static void lv_example_led_1(void)
{
    /* 根据活动屏幕宽度选择字体 */
    if (scr_act_width() <= 480)
        {
            font = &lv_font_montserrat_14;
        }
    else
        {
            font = &lv.Font_montserrat_20;
        }
    /* 创建基础对象作为背景 */
    obj = lv_obj_create(lv_scr_act());
    lv_obj_set_size(obj, scr_act_width() * 5 / 6, scr_actu_height() * 3 / 5);
    lv_obj_align(obj, LV_ALIGN_CENTER, 0, 0);
    lv_obj_set_style bg_color(obj, lv_color_hex(0xe9efef), LV_STATE_DEFAULT);
    lv_obj_t* led = lv_led_create(obj); /* 创建LED */
    /* 设置LED大小 */
    lv_obj_set_size(led, scr_actu_height() / 5, scr_actu_height() / 5);
    lv_obj_align(led, LV_ALIGN_CENTER, -scr_actu_width() * 4 / 15,
                    -scr_actu_height() / 15); /* 设置LED位置 */
    lv_led_off(led); /* 关闭LED */
    /* 设置LED事件回调 */
    lv_obj_add_event_cb(led, led_event_cb, LV_EVENTCLICKED, NULL);
```

```c
lv_obj_t *label = lv_label_create(lv_scr_act()); /* 创建LED功能标签*/ lv_label_set_text.label, "ROOM 1"); /* 设置文本*/ lv_obj_set_style_text.Font (label,font,LV_STATE_DEFAULT); /* 设置字体*/ lv_obj_align_to labelled,led,LV_ALIGN_OUT BOTTOM_MID,0, scr_actu height(/15); /*设置位置*/   
}   
